use flake

# Keep local environment deterministic and fail-fast for CLI development.
watch_file flake.nix
watch_file pyproject.toml
watch_file uv.lock

if [[ ! -x .venv/bin/python ]]; then
  echo "[direnv] bootstrapping .venv via uv sync --group all"
  uv sync --group all
fi

PATH_add .venv/bin
export PYTHONPATH="$PWD/src${PYTHONPATH:+:$PYTHONPATH}"
